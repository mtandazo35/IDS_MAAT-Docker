#!/bin/sh
# tzsp-decap (longrun): CONTRATO-F1a §5.4. Un solo origen y una sola interfaz: TUN_MK (el
# MikroTik por la VPN) o, en un punto directo, MK_IP (su IP de la LAN).
# Si falta o no es válido, TZSP_ALLOW es inválido y el receptor no arranca.
exec 2>&1
umask 027
TZSP_PORT="${TZSP_PUERTO:-}"
if [ "${MODO:-vpn}" = "directo" ]; then
  TZSP_ALLOW="${MK_IP:-}/32"
else
  TZSP_ALLOW="${TUN_MK:-}/32"
fi
TZSP_OUT_IF=ids-in
TZSP_ESTADO=/run/ids/tzsp.json
TZSP_BYTES="${TZSP_BYTES:-}"
export TZSP_PORT TZSP_ALLOW TZSP_OUT_IF TZSP_ESTADO TZSP_BYTES
unset TZSP_MAP
exec python3 -u /usr/local/bin/tzsp-decap
