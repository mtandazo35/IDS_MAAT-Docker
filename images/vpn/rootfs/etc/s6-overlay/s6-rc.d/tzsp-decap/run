#!/bin/sh
# tzsp-decap (longrun): CONTRATO-F1a §5.4. Una sola interfaz. Con VPN, un solo origen: TUN_MK (el
# MikroTik por el túnel; si falta, TZSP_ALLOW es inválido y el receptor no arranca). En un punto
# directo, cualquier origen (el dueño, 2026-10-20: «necesito que escuche cualquier IP»; el MikroTik
# puede mandarlo desde una IP que no es la de su API, p. ej. la de un enlace 100.64.x).
exec 2>&1
umask 027
TZSP_PORT="${TZSP_PUERTO:-}"
if [ "${MODO:-vpn}" = "directo" ]; then
  TZSP_ALLOW="0.0.0.0/0"
else
  TZSP_ALLOW="${TUN_MK:-}/32"
fi
TZSP_OUT_IF=ids-in
TZSP_ESTADO=/run/ids/tzsp.json
TZSP_BYTES="${TZSP_BYTES:-}"
export TZSP_PORT TZSP_ALLOW TZSP_OUT_IF TZSP_ESTADO TZSP_BYTES
unset TZSP_MAP
exec python3 -u /usr/local/bin/tzsp-decap
