#!/bin/sh
# rele-api (longrun): CONTRATO-F1a §5.5. Relé UNIX -> API-SSL del MikroTik por tun0 o, en un
# punto directo, a su IP de la LAN por eth0.
# umask 007 + mode=660: el socket queda 0660 y, por el setgid de /run/ids (2770),
# grupo 10500 (socat no puede fijar group= sin CAP_CHOWN). El relé no ve credenciales:
# el TLS va de extremo a extremo.
exec 2>&1
umask 007
destino="${TUN_MK}"
if [ "${MODO:-vpn}" = "directo" ]; then
  destino="${MK_IP}"
fi
exec socat UNIX-LISTEN:/run/ids/api.sock,fork,unlink-early,mode=660,max-children=4 \
           "TCP:${destino}:${API_PUERTO},connect-timeout=5"
