#!/usr/bin/env python3
"""salud-suricata — healthcheck del contenedor suricata (CONTRATO-F1a §5.7).

Sano (exit 0) si:
  - /proc/1/cmdline contiene "suricata", y
  - en los últimos 512 KiB de /var/log/suricata/eve.json hay una línea con
    "event_type":"stats" cuyo timestamp tiene menos de 120 s.

Nunca falla por falta de tráfico: el evento stats sale cada 30 s aunque no llegue nada.
Para las pruebas acepta IDS_EVE (ruta del eve) e IDS_AHORA (epoch) en el entorno.
"""
import json
import os
import sys
import time
from datetime import datetime

EVE = "/var/log/suricata/eve.json"
CMDLINE = "/proc/1/cmdline"
COLA_BYTES = 512 * 1024
MAX_EDAD_S = 120


def leer_cmdline(ruta=CMDLINE):
    try:
        with open(ruta, "rb") as f:
            return f.read()
    except OSError:
        return b""


def ts_epoch(texto):
    """Timestamp del eve ("2026-10-10T08:15:00.123456+0000") a epoch, o None."""
    if not isinstance(texto, str):
        return None
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z"):
        try:
            return datetime.strptime(texto, fmt).timestamp()
        except ValueError:
            continue
    return None


def cola(ruta, nbytes=COLA_BYTES):
    """Las líneas completas de los últimos nbytes del fichero."""
    with open(ruta, "rb") as f:
        f.seek(0, os.SEEK_END)
        tam = f.tell()
        ini = max(0, tam - nbytes)
        f.seek(ini)
        datos = f.read()
    lineas = datos.split(b"\n")
    if ini > 0 and lineas:
        lineas = lineas[1:]          # la primera puede estar cortada
    return lineas


def ultimo_stats(ruta, nbytes=COLA_BYTES):
    """Epoch del evento stats más reciente en la cola del eve, o None."""
    mejor = None
    for linea in cola(ruta, nbytes):
        if b'"event_type":"stats"' not in linea.replace(b" ", b""):
            continue
        try:
            ev = json.loads(linea.decode("utf-8", "replace"))
        except ValueError:
            continue
        if not isinstance(ev, dict) or ev.get("event_type") != "stats":
            continue
        t = ts_epoch(ev.get("timestamp"))
        if t is not None and (mejor is None or t > mejor):
            mejor = t
    return mejor


def comprobar(eve=EVE, ahora=None, cmdline=None):
    """(sano, motivo)."""
    if ahora is None:
        ahora = time.time()
    if cmdline is None:
        cmdline = leer_cmdline()
    if b"suricata" not in cmdline:
        return False, "el PID 1 no es suricata"
    try:
        t = ultimo_stats(eve)
    except OSError as e:
        return False, "no se puede leer %s: %s" % (eve, e.strerror or e)
    if t is None:
        return False, "sin evento stats en los últimos %d KiB de %s" % (COLA_BYTES // 1024, eve)
    edad = ahora - t
    if edad >= MAX_EDAD_S:
        return False, "último stats de hace %d s (máximo %d s)" % (edad, MAX_EDAD_S)
    return True, "stats de hace %d s" % max(0, edad)


def main(env=None, cmdline=None):
    env = os.environ if env is None else env
    eve = env.get("IDS_EVE") or EVE
    ahora = None
    if env.get("IDS_AHORA"):
        try:
            ahora = float(env["IDS_AHORA"])
        except ValueError:
            print("salud-suricata: IDS_AHORA no es un número")
            return 1
    sano, motivo = comprobar(eve, ahora, cmdline)
    print("salud-suricata: %s: %s" % ("sano" if sano else "MAL", motivo))
    return 0 if sano else 1


if __name__ == "__main__":
    sys.exit(main())
