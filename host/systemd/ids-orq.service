# ids-maat: orquestador (servicio + socket /run/ids-orq/orq.sock). Encierro de ORQUESTADOR §1.1.
[Unit]
Description=IDS-MAAT: orquestador ids-orq
Documentation=https://github.com/mtandazo35/IDS_MAAT-Docker/blob/main/docs/ORQUESTADOR.md
After=docker.service ids-host-fw.service
Requires=docker.service
Wants=ids-host-fw.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ids-orq servicio
Restart=always
RestartSec=5
RuntimeDirectory=ids-orq
RuntimeDirectoryMode=0750
# el panel monta /run/ids-orq: el directorio no se borra al reiniciar el servicio (si no, el
# montaje del contenedor se quedaría con el inodo viejo y sin socket)
RuntimeDirectoryPreserve=yes
UMask=0027
TimeoutStopSec=30
# el CLI de docker escribe su configuración aquí, no en /root (ProtectHome=read-only)
Environment=DOCKER_CONFIG=/srv/ids/estado/docker PYTHONUNBUFFERED=1
ProtectSystem=strict
ReadWritePaths=/srv/ids /root/backups /run/ids-orq
PrivateTmp=yes
ProtectHome=read-only
NoNewPrivileges=yes
# tope de memoria (auditoría A-04): lo que lee de los directorios de los contenedores ya va con
# tope; esto es la red de seguridad para que un fallo del orquestador no se coma la RAM de los
# puntos. Los procesos docker/compose que lanza cuentan aquí y caben de sobra.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
