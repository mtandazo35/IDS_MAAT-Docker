# ids-maat — generado por ids-orq; no editar
name: ids-@@PID@@
services:
  vpn:
    image: @@IMAGEN_VPN@@
    container_name: ids-@@PID@@-vpn
    hostname: ids-@@PID@@-vpn
    restart: unless-stopped
    labels: { ids-maat.punto: "@@PID@@", ids-maat.parte: "vpn", ids-maat.version: "@@VERSION@@" }
    cap_drop: [ALL]
    cap_add: [NET_ADMIN, NET_RAW]
    devices: ["/dev/net/tun:/dev/net/tun"]
    security_opt: ["no-new-privileges:true"]
    read_only: true
    tmpfs: ["/run:exec,size=16m", "/tmp:size=16m"]
    sysctls:
      net.ipv4.ip_forward: "0"
      net.ipv6.conf.all.disable_ipv6: "1"
      net.ipv6.conf.default.disable_ipv6: "1"
      net.ipv4.conf.default.rp_filter: "1"
      net.ipv4.ipfrag_high_thresh: "67108864"
      net.ipv4.ipfrag_time: "15"
    ports: ["@@PUERTO@@:1194/tcp"]
    networks: [punto]
    environment:
      PUNTO: "@@PID@@"
      N: "@@N@@"
      TUN_NET: "@@TUN_NET@@"
      TUN_SENSOR: "@@TUN_SENSOR@@"
      TUN_MK: "@@TUN_MK@@"
      API_PUERTO: "@@API_PUERTO@@"
      TZSP_PUERTO: "@@TZSP_PUERTO@@"
      TZSP_BYTES: "@@TZSP_BYTES@@"
      TZ: "UTC"
    volumes:
      - @@RAIZ@@/srv/ids/puntos/@@PID@@/vpn:/etc/ids/vpn:ro
      - @@RAIZ@@/srv/ids/run/@@PID@@:/run/ids
      - @@RAIZ@@/srv/ids/ctl/@@PID@@/vpn:/run/ids-ctl
    logging: { driver: journald, options: { tag: ids-vpn } }
    @@LINEA_CPUSET_VPN@@
    mem_limit: @@MEM_VPN@@
    memswap_limit: @@MEM_VPN@@
    pids_limit: 64
    healthcheck:
      test: ["CMD", "/usr/local/bin/salud-vpn"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
  suricata:
    image: @@IMAGEN_SURICATA@@
    container_name: ids-@@PID@@-suricata
    network_mode: "service:vpn"
    depends_on: { vpn: { condition: service_healthy, restart: true } }
    restart: unless-stopped
    labels: { ids-maat.punto: "@@PID@@", ids-maat.parte: "suricata", ids-maat.version: "@@VERSION@@" }
    cap_drop: [ALL]
    cap_add: [NET_RAW, NET_ADMIN]
    security_opt: ["no-new-privileges:true"]
    read_only: true
    tmpfs: ["/tmp:size=64m", "/run:size=8m"]
    environment: { PUNTO: "@@PID@@", IDS_ESPERA_MON_S: "@@ESPERA_MON@@", TZ: "UTC" }
    volumes:
      - @@RAIZ@@/srv/ids/reglas:/reglas:ro
      - @@RAIZ@@/srv/ids/puntos/@@PID@@/suricata:/etc/ids/suricata:ro
      - @@RAIZ@@/srv/ids/datos/@@PID@@:/var/log/suricata
      - @@RAIZ@@/srv/ids/ctl/@@PID@@/suricata:/run/suricata
    @@LINEA_CPUSET_SURICATA@@
    cpus: @@HILOS@@
    mem_limit: @@MEM_SURICATA@@
    memswap_limit: @@MEM_SURICATA@@
    pids_limit: 256
    stop_grace_period: 30s
    healthcheck:
      test: ["CMD", "/usr/local/bin/salud-suricata"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 180s
networks:
  punto:
    name: ids-@@PID@@
    driver: bridge
    driver_opts: { com.docker.network.bridge.name: ids-@@PID@@ }
    ipam: { config: [ { subnet: @@SUBRED@@ } ] }
