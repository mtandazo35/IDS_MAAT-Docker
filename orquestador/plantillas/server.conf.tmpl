# ids-maat @@PID@@ — generado por ids-orq; no editar
port 1194
proto tcp4-server
dev tun0
topology subnet
server @@TUN_RED@@ 255.255.255.0
max-clients 2
tls-server
tls-version-min 1.2
@@LINEA_TLS_CIPHER@@
@@LINEA_TLS_CERT_PROFILE@@
ca /etc/ids/vpn/ca.crt
cert /etc/ids/vpn/server.crt
key /etc/ids/vpn/server.key
dh /etc/ids/vpn/dh.pem
data-ciphers AES-256-GCM:AES-256-CBC
data-ciphers-fallback @@FALLBACK@@
auth SHA1
verify-client-cert none
username-as-common-name
auth-user-pass-verify /usr/local/bin/ovpn-auth via-file
script-security 2
tmp-dir /tmp
client-config-dir /etc/ids/vpn/ccd
ccd-exclusive
keepalive 10 60
persist-key
persist-tun
status /run/ids/openvpn-status.log 10
status-version 2
management /run/ids-ctl/ovpn-mgmt.sock unix
suppress-timestamps
verb 3
